  {
   "parameters": {
    "mode": "runOnceForEachItem",
    "jsCode": "// Turn one converter result row into everything the delivery steps\n// need. The Actor returns one row per source file: status ok /\n// no_notes / skipped / error, with midiUrl set only when a MIDI was\n// produced. Non-ok rows are flagged so the IF can route them back to\n// the loop \u2014 the converter does not charge for them.\nlet src = {};\ntry { src = $('Build Apify audio URL').item.json || {}; } catch (e) { src = {}; }\nconst row = $json || {};\nconst ok = row.status === 'ok' && !!row.midiUrl;\nconst sourceFile = src.driveFileName || row.fileName || 'audio file';\nconst base = String(sourceFile).replace(/\\.[^.]+$/, '') || 'audio';\nreturn { json: {\n  ok: ok ? 1 : 0,\n  status: row.status || 'no_result',\n  error: row.error || (ok ? '' : 'The converter returned no result row for this file.'),\n  sourceFile,\n  title: row.title || base,\n  midiFileName: base + '.mid',\n  midiUrl: row.midiUrl || '',\n  notesJsonUrl: row.notesJsonUrl || '',\n  noteCount: row.noteCount ?? '',\n  tempoBpm: row.tempoBpm ?? '',\n  musicalKey: row.key ?? '',\n  durationSecs: row.durationSecs ?? '',\n  billedMinutes: row.billedMinutes ?? '',\n  convertedAt: row.convertedAt || new Date().toISOString(),\n} };"
   },
   "name": "Prepare MIDI delivery",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1580,
    340
   ],
   "id": "n7"
  },
