  {
   "parameters": {
    "mode": "runOnceForEachItem",
    "jsCode": "// Build the Sheet log row and the Telegram message for one converted\n// file. The Drive upload output carries the saved file's link; the\n// conversion facts (notes, key, tempo) come from the Prepare step's\n// paired item.\nlet prep = {};\ntry { prep = $('Prepare MIDI delivery').item.json || {}; } catch (e) { prep = {}; }\nconst drive = $json || {};\nconst midiLink = drive.webViewLink || prep.midiUrl || '';\nconst telegramText =\n  `\ud83c\udfb5 MIDI ready: ${prep.title || prep.sourceFile || 'your audio'}\\n` +\n  `Source: ${prep.sourceFile || ''}\\n` +\n  `${prep.noteCount} notes \u00b7 key of ${prep.musicalKey} \u00b7 ${prep.tempoBpm} BPM\\n` +\n  `MIDI: ${midiLink}`;\nreturn { json: {\n  sourceFile: prep.sourceFile || '',\n  convertedAt: prep.convertedAt || new Date().toISOString(),\n  noteCount: prep.noteCount ?? '',\n  musicalKey: prep.musicalKey ?? '',\n  tempoBpm: prep.tempoBpm ?? '',\n  midiLink,\n  telegramText,\n} };"
   },
   "name": "Build log row + Telegram message",
