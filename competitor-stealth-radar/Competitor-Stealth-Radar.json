    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Assemble the Slack alert text and the Log-sheet row for one new filing:\n// the filing fields come from the filter node, the AI summary is this\n// item's input (the LLM chain's text output).\nconst f = $('Keep only new filings').item.json;\nconst summary = $json.text ?? '';\nconst markDisplay = f.wordmark ? `\"${f.wordmark}\"` : '(design mark \\u2014 no wordmark text)';\nconst alertText = [\n  '\\uD83D\\uDEA8 New competitor trademark filing',\n  `*${f.owner}* filed ${markDisplay}`,\n  `Class ${f.internationalClasses} \\u00B7 Filed ${f.filedDate} \\u00B7 Serial ${f.serialNumber}`,\n  summary,\n  `USPTO record: ${f.tsdrUrl}`,\n].join('\\n');\nreturn { json: {\n  serialNumber: f.serialNumber,\n  wordmark: f.wordmark,\n  owner: f.owner,\n  filedDate: f.filedDate,\n  internationalClasses: f.internationalClasses,\n  goodsAndServices: f.goodsAndServices,\n  aiSummary: summary,\n  dateLogged: new Date().toISOString().slice(0, 10),\n  alertText,\n} };\n"
      },
      "name": "Build the alert + log row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1840,
        340
      ],
      "id": "n11"
    },
