        "customBody": "={{ JSON.stringify({ owner: $json.ownerName, status: 'live', filedAfter: $now.minus({ days: Number($('Set your watch settings').first().json.lookback_days) || 14 }).toFormat('yyyy-MM-dd'), maxResults: Number($('Set your watch settings').first().json.max_results_per_competitor) || 50 }) }}",
