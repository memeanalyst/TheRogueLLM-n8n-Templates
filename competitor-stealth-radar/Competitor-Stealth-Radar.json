    {
      "parameters": {
        "jsCode": "// Keep only filings that are genuinely new: drop anything whose serial\n// number is already in the Log sheet, and duplicates inside this batch.\n// The Apify node always outputs one item, so an empty result arrives as an\n// item with no serialNumber. When nothing is new, emit ONE marker item so\n// the loop still advances to the next competitor.\nconst logged = new Set(\n  $('Read filing log').all()\n    .map(i => String(i.json.serialNumber ?? ''))\n    .filter(Boolean)\n);\nconst seenThisRun = new Set();\nconst fresh = [];\nfor (const { json: f } of $input.all()) {\n  if (!f.serialNumber) continue;\n  const serial = String(f.serialNumber);\n  if (logged.has(serial) || seenThisRun.has(serial)) continue;\n  seenThisRun.add(serial);\n  fresh.push({ json: {\n    serialNumber: serial,\n    wordmark: f.wordmark ?? '',\n    owner: f.owner ?? '',\n    filedDate: f.filedDate ?? '',\n    internationalClasses: (f.internationalClasses ?? []).join(', '),\n    goodsAndServices: f.goodsAndServices ?? '',\n    tsdrUrl: f.tsdrUrl ?? '',\n    isNew: 1,\n  }});\n}\nif (!fresh.length) {\n  return [{ json: { noneFound: true, isNew: 0 } }];\n}\nreturn fresh;\n"
      },
      "name": "Keep only new filings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1150,
        340
      ],
      "id": "n7"
    },
